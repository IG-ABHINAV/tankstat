<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" Version="16.7.3" />
    <!-- Telemetry (docs/configuration.md, Telemetry): HotChocolate.Diagnostics goes with HotChocolate.AspNetCore's version. The EF Core
         instrumentation is a beta, registered only behind Telemetry:TraceDatabase; 1.20.0-beta.1 or later (no exception message in the span). -->
    <PackageReference Include="HotChocolate.Diagnostics" Version="16.7.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.20.1-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tankstat.Application\Tankstat.Application.csproj" />
    <ProjectReference Include="..\Tankstat.Infrastructure\Tankstat.Infrastructure.csproj" />
    <ProjectReference Include="..\Tankstat.Migrations.Sqlite\Tankstat.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\Tankstat.Migrations.PostgreSql\Tankstat.Migrations.PostgreSql.csproj" />
    <ProjectReference Include="..\Tankstat.Migrations.SqlServer\Tankstat.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\Tankstat.Migrations.MySql\Tankstat.Migrations.MySql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tankstat.Api.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app's own settings file of a local run (mise run dev:api) holds secrets and belongs to that run: the Web SDK would copy any *.json
         here into bin/, the bins of the test projects (where the Seeder's tests would read it) and the published out/. -->
    <Content Remove="settings.json" />
  </ItemGroup>

</Project>
