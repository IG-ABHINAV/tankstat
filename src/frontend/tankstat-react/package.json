{
  "name": "tankstat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run unit",
    "test:integration": "vitest run integration",
    "test:coverage": "vitest run --coverage && npm run coverage:paths",
    "coverage:paths": "node -e \"const fs=require('fs'),f='../../../coverage/frontend/lcov.info';fs.writeFileSync(f,fs.readFileSync(f,'utf8').replace(/^SF:/gm,'SF:src/frontend/tankstat-react/src/'))\"",
    "typecheck": "tsc -b",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@apollo/client": "^4.3.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@mui/x-charts": "^9.17.0",
    "@mui/x-data-grid": "^9.17.0",
    "@mui/x-date-pickers": "^9.17.0",
    "dayjs": "^1.11.23",
    "graphql": "^17.0.2",
    "i18next": "^26.5.12",
    "i18next-browser-languagedetector": "^8.2.4",
    "i18next-resources-to-backend": "^1.2.3",
    "lucide-react": "^1.65.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "^2.3.0",
    "react-i18next": "^17.1.9",
    "react-router": "^8.5.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typed-document-node": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.2.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.13.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  }
}
